#!/usr/bin/env bash
set -euo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_dir="${DOTS_DIR:-$(cd -- "$(dirname -- "$script_path")/.." && pwd)}"
theme="${1:-tokyo-night}"
theme_file="$repo_dir/themes/$theme/colors.toml"

if [ ! -f "$theme_file" ]; then
  printf 'Theme not found: %s\n' "$theme" >&2
  exit 1
fi

load_theme() {
  in_colors=0

  while IFS= read -r line; do
    if [[ "$line" =~ ^[[:space:]]*\[colors\][[:space:]]*$ ]]; then
      in_colors=1
      continue
    fi

    if [[ "$line" =~ ^[[:space:]]*\[.*\][[:space:]]*$ ]]; then
      in_colors=0
      continue
    fi

    [ "$in_colors" = 1 ] || continue

    if [[ "$line" =~ ^[[:space:]]*([a-zA-Z0-9_]+)[[:space:]]*=[[:space:]]*\"([^\"]*)\"[[:space:]]*$ ]]; then
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"

      case "$key" in
        bg) BASE_BG="$value" ;;
        surface) BASE_SURFACE="$value" ;;
        text) BASE_TEXT="$value" ;;
        dim) BASE_DIM="$value" ;;
        accent) BASE_ACCENT="$value" ;;
        accent_alt) BASE_ACCENT_ALT="$value" ;;
        edge) BASE_EDGE="$value" ;;
        shadow) BASE_SHADOW="$value" ;;
        neutral) BASE_NEUTRAL="$value" ;;
        cursor_text) BASE_CURSOR_TEXT="$value" ;;
        selection_bg) BASE_SELECTION_BG="$value" ;;
        selection_fg) BASE_SELECTION_FG="$value" ;;
        bg_subtle) BASE_BG_SUBTLE="$value" ;;
        bg_highlight) BASE_BG_HIGHLIGHT="$value" ;;
        fg_muted) BASE_FG_MUTED="$value" ;;
        fg_gutter) BASE_FG_GUTTER="$value" ;;
        comment) BASE_COMMENT="$value" ;;
        black) BASE_BLACK="$value" ;;
        red) BASE_RED="$value" ;;
        green) BASE_GREEN="$value" ;;
        yellow) BASE_YELLOW="$value" ;;
        blue) BASE_BLUE="$value" ;;
        magenta) BASE_MAGENTA="$value" ;;
        cyan) BASE_CYAN="$value" ;;
        white) BASE_WHITE="$value" ;;
        bright_black) BASE_BRIGHT_BLACK="$value" ;;
        bright_red) BASE_BRIGHT_RED="$value" ;;
        bright_green) BASE_BRIGHT_GREEN="$value" ;;
        bright_yellow) BASE_BRIGHT_YELLOW="$value" ;;
        bright_blue) BASE_BRIGHT_BLUE="$value" ;;
        bright_magenta) BASE_BRIGHT_MAGENTA="$value" ;;
        bright_cyan) BASE_BRIGHT_CYAN="$value" ;;
        bright_white) BASE_BRIGHT_WHITE="$value" ;;
      esac
    fi
  done < "$theme_file"
}

missing_colors=()

require_color() {
  name="$1"
  value="$2"

  if [ -z "$value" ]; then
    missing_colors+=("$name")
  fi
}

validate_theme() {
  require_color bg "${BASE_BG:-}"
  require_color surface "${BASE_SURFACE:-}"
  require_color text "${BASE_TEXT:-}"
  require_color dim "${BASE_DIM:-}"
  require_color accent "${BASE_ACCENT:-}"
  require_color accent_alt "${BASE_ACCENT_ALT:-}"
  require_color edge "${BASE_EDGE:-}"
  require_color shadow "${BASE_SHADOW:-}"
  require_color neutral "${BASE_NEUTRAL:-}"

  if [ "${#missing_colors[@]}" -gt 0 ]; then
    printf 'Theme %s is missing required [colors] keys in %s: %s\n' "$theme" "$theme_file" "${missing_colors[*]}" >&2
    exit 1
  fi
}

load_theme
validate_theme

write_file() {
  dest="$1"
  content="$2"

  if [ "${DOTS_DRY_RUN:-0}" = 1 ]; then
    printf '[dry-run] write %s\n' "$dest"
    return 0
  fi

  mkdir -p "$(dirname -- "$dest")"
  printf '%s\n' "$content" >"$dest"
}

link_palette() {
  dest="$HOME/.config/theme/palette.toml"

  if [ "${DOTS_DRY_RUN:-0}" = 1 ]; then
    printf '[dry-run] link %s -> %s\n' "$dest" "$theme_file"
    return 0
  fi

  mkdir -p "$(dirname -- "$dest")"
  if [ -L "$dest" ] && [ "$(readlink -- "$dest")" = "$theme_file" ]; then
    return 0
  fi

  if [ -e "$dest" ] || [ -L "$dest" ]; then
    mv "$dest" "$dest.backup.$(date +%Y%m%d%H%M%S)"
  fi

  ln -s "$theme_file" "$dest"
}

hex() {
  printf '%s' "${1#\#}"
}

link_palette

write_file "$HOME/.config/hypr/colors.conf" "\$themeAccentGradient = rgba($(hex "$BASE_ACCENT_ALT")ee) rgba($(hex "$BASE_ACCENT")ee) 45deg
\$themeNeutralLine = rgba($(hex "$BASE_NEUTRAL")aa)
\$themeShadow = rgba($(hex "$BASE_SHADOW")ee)"

write_file "$HOME/.config/waybar/colors.css" "@define-color bg $BASE_BG;
@define-color bg2 $BASE_SURFACE;
@define-color fg $BASE_TEXT;
@define-color muted $BASE_DIM;
@define-color accent $BASE_ACCENT;
@define-color accent2 $BASE_ACCENT_ALT;
@define-color border $BASE_EDGE;"

write_file "$HOME/.config/wofi/style.css" "window {
  background-color: $BASE_BG;
  color: $BASE_TEXT;
  border: 1px solid $BASE_EDGE;
  border-radius: 14px;
}

#outer-box,
#inner-box {
  margin: 0;
  padding: 8px;
  background-color: transparent;
}

#input {
  margin: 8px;
  padding: 8px 10px;
  border: 1px solid $BASE_EDGE;
  border-radius: 10px;
  background-color: $BASE_SURFACE;
  color: $BASE_TEXT;
}

#entry {
  padding: 8px 10px;
  border-radius: 10px;
  background-color: transparent;
  color: $BASE_TEXT;
}

#entry:selected {
  background-color: $BASE_ACCENT_ALT;
  color: $BASE_BG;
}

#text {
  color: inherit;
}

#img {
  margin-right: 8px;
}"

write_file "$HOME/.config/alacritty/themes/$theme.toml" "[colors.primary]
background = \"$BASE_BG\"
foreground = \"$BASE_TEXT\"

[colors.cursor]
text = \"${BASE_CURSOR_TEXT:-$BASE_BG}\"
cursor = \"$BASE_TEXT\"

[colors.selection]
text = \"${BASE_SELECTION_FG:-$BASE_TEXT}\"
background = \"${BASE_SELECTION_BG:-$BASE_ACCENT_ALT}\"

[colors.normal]
black = \"${BASE_BLACK:-$BASE_SHADOW}\"
red = \"${BASE_RED:-$BASE_ACCENT}\"
green = \"${BASE_GREEN:-$BASE_NEUTRAL}\"
yellow = \"${BASE_YELLOW:-$BASE_ACCENT}\"
blue = \"${BASE_BLUE:-$BASE_ACCENT}\"
magenta = \"${BASE_MAGENTA:-$BASE_ACCENT_ALT}\"
cyan = \"${BASE_CYAN:-$BASE_ACCENT_ALT}\"
white = \"$BASE_TEXT\"

[colors.bright]
black = \"${BASE_BRIGHT_BLACK:-$BASE_EDGE}\"
red = \"${BASE_BRIGHT_RED:-$BASE_ACCENT}\"
green = \"${BASE_BRIGHT_GREEN:-$BASE_NEUTRAL}\"
yellow = \"${BASE_BRIGHT_YELLOW:-$BASE_ACCENT}\"
blue = \"${BASE_BRIGHT_BLUE:-$BASE_ACCENT}\"
magenta = \"${BASE_BRIGHT_MAGENTA:-$BASE_ACCENT_ALT}\"
cyan = \"${BASE_BRIGHT_CYAN:-$BASE_ACCENT_ALT}\"
white = \"${BASE_BRIGHT_WHITE:-$BASE_TEXT}\""

active_target="$HOME/.config/alacritty/themes/active.toml"

# Read the per-theme file we just wrote, then copy its content into active.toml.
# We do this so alacritty's live_config_reload (inotify) sees a content change
# in the same path it imports, instead of a symlink swap that inotify ignores.
if [ "${DOTS_DRY_RUN:-0}" = 1 ]; then
  printf '[dry-run] write %s (copy of current theme)\n' "$active_target"
else
  mkdir -p "$(dirname -- "$active_target")"
  if [ -e "$active_target" ] && ! [ -L "$active_target" ] && cmp -s "$HOME/.config/alacritty/themes/$theme.toml" "$active_target"; then
    :
  else
    if [ -e "$active_target" ] || [ -L "$active_target" ]; then
      mv "$active_target" "$active_target.backup.$(date +%Y%m%d%H%M%S)"
    fi
    cp "$HOME/.config/alacritty/themes/$theme.toml" "$active_target"
  fi
fi

# Track the active theme in a small state file so `dots theme current` can
# report the actually-applied theme (not just the default in components.conf).
state_file="$HOME/.config/theme/active"
if [ "${DOTS_DRY_RUN:-0}" = 1 ]; then
  printf '[dry-run] write %s\n' "$state_file"
else
  mkdir -p "$(dirname -- "$state_file")"
  printf '%s\n' "$theme" >"$state_file"
fi

write_file "$HOME/.config/tmux/colors.conf" "# Generated by \`dots theme apply\`.
# Source of truth: themes/<theme>/colors.toml (see ~/.config/theme/palette.toml).
# This file is overwritten on every theme apply. Do not edit by hand.

# Semantic colors
set -g @color_bg           \"$BASE_BG\"
set -g @color_fg           \"$BASE_TEXT\"
set -g @color_accent       \"$BASE_TEXT\"
set -g @color_accent_text  \"$BASE_BG\"
set -g @color_selection_bg \"${BASE_SELECTION_BG:-$BASE_SURFACE}\"
set -g @color_selection_fg \"$BASE_TEXT\"

# Raw palette — colors referenced by tmux.conf styling
set -g @color_bright_black \"${BASE_BRIGHT_BLACK:-$BASE_EDGE}\"
set -g @color_red          \"${BASE_RED:-$BASE_ACCENT}\""

write_file "$HOME/.config/opencode/tui.json" "{
  \"\$schema\": \"https://opencode.ai/tui.json\",
  \"theme\": \"dots\"
}"

write_file "$HOME/.config/opencode/themes/dots.json" "{
  \"\$schema\": \"https://opencode.ai/theme.json\",
  \"theme\": {
    \"primary\": \"$BASE_ACCENT\",
    \"secondary\": \"$BASE_ACCENT_ALT\",
    \"accent\": \"$BASE_ACCENT\",
    \"error\": \"$BASE_ACCENT_ALT\",
    \"warning\": \"$BASE_NEUTRAL\",
    \"success\": \"$BASE_ACCENT\",
    \"info\": \"$BASE_ACCENT_ALT\",
    \"text\": \"$BASE_TEXT\",
    \"textMuted\": \"$BASE_DIM\",
    \"background\": \"$BASE_BG\",
    \"backgroundPanel\": \"$BASE_SURFACE\",
    \"backgroundElement\": \"$BASE_SURFACE\",
    \"border\": \"$BASE_EDGE\",
    \"borderActive\": \"$BASE_ACCENT\",
    \"borderSubtle\": \"$BASE_EDGE\",
    \"diffAdded\": \"$BASE_ACCENT\",
    \"diffRemoved\": \"$BASE_ACCENT_ALT\",
    \"diffContext\": \"$BASE_DIM\",
    \"diffHunkHeader\": \"$BASE_NEUTRAL\",
    \"diffHighlightAdded\": \"$BASE_ACCENT\",
    \"diffHighlightRemoved\": \"$BASE_ACCENT_ALT\",
    \"diffAddedBg\": \"$BASE_SURFACE\",
    \"diffRemovedBg\": \"$BASE_SURFACE\",
    \"diffContextBg\": \"$BASE_BG\",
    \"diffLineNumber\": \"$BASE_DIM\",
    \"diffAddedLineNumberBg\": \"$BASE_SURFACE\",
    \"diffRemovedLineNumberBg\": \"$BASE_SURFACE\",
    \"markdownText\": \"$BASE_TEXT\",
    \"markdownHeading\": \"$BASE_ACCENT\",
    \"markdownLink\": \"$BASE_ACCENT_ALT\",
    \"markdownLinkText\": \"$BASE_ACCENT\",
    \"markdownCode\": \"$BASE_NEUTRAL\",
    \"markdownBlockQuote\": \"$BASE_DIM\",
    \"markdownEmph\": \"$BASE_ACCENT_ALT\",
    \"markdownStrong\": \"$BASE_ACCENT\",
    \"markdownHorizontalRule\": \"$BASE_EDGE\",
    \"markdownListItem\": \"$BASE_ACCENT\",
    \"markdownListEnumeration\": \"$BASE_ACCENT_ALT\",
    \"markdownImage\": \"$BASE_ACCENT_ALT\",
    \"markdownImageText\": \"$BASE_ACCENT\",
    \"markdownCodeBlock\": \"$BASE_TEXT\",
    \"syntaxComment\": \"$BASE_DIM\",
    \"syntaxKeyword\": \"$BASE_ACCENT\",
    \"syntaxFunction\": \"$BASE_ACCENT_ALT\",
    \"syntaxVariable\": \"$BASE_TEXT\",
    \"syntaxString\": \"$BASE_NEUTRAL\",
    \"syntaxNumber\": \"$BASE_ACCENT_ALT\",
    \"syntaxType\": \"$BASE_NEUTRAL\",
    \"syntaxOperator\": \"$BASE_ACCENT\",
    \"syntaxPunctuation\": \"$BASE_TEXT\"
  }
}"

printf 'Applied theme: %s\n' "$theme"
