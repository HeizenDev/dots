#!/usr/bin/env bash
set -euo pipefail

services=(NetworkManager bluetooth sddm)

if [ "${DOTS_DRY_RUN:-0}" = 1 ]; then
  for service in "${services[@]}"; do
    printf '[dry-run] sudo systemctl enable --now %q\n' "$service"
  done
  exit 0
fi

for service in "${services[@]}"; do
  if systemctl list-unit-files "$service.service" >/dev/null 2>&1; then
    sudo systemctl enable --now "$service"
  else
    printf 'Skipping missing service: %s\n' "$service"
  fi
done
