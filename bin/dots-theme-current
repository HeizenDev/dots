#!/usr/bin/env bash
set -euo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_dir="${DOTS_DIR:-$(cd -- "$(dirname -- "$script_path")/.." && pwd)}"

state_file="$HOME/.config/theme/active"
if [ -f "$state_file" ]; then
  cat "$state_file"
  exit 0
fi

# Fall back to the default theme in components.conf when no theme has been
# applied yet (fresh install).
if [ -f "$repo_dir/hosts/current/components.conf" ]; then
  # shellcheck disable=SC1090
  source "$repo_dir/hosts/current/components.conf"
  printf '%s\n' "${THEME:-tokyo-night}"
else
  printf 'tokyo-night\n'
fi
